# Backends (defaults match `make pf`). Prometheus·Loki는 kubectl proxy(:8001)의 Service 프록시 경로로 붙는다
PROMETHEUS_URL=http://localhost:8001/api/v1/namespaces/ngds-monitoring/services/prometheus:9090/proxy
LOKI_URL=http://localhost:8001/api/v1/namespaces/ngds-monitoring/services/loki:3100/proxy
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=semantic-obs

# Target application (placeholder defaults for catalog templates)
TARGET_NAMESPACE=ngds
TARGET_POD=postgres-.*
DATA_MOUNTPOINT=/
